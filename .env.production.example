APP_NAME=Docker Support Agent
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

POSTGRES_DB=docker_agent
POSTGRES_USER=docker_agent
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://docker_agent:REPLACE_WITH_STRONG_RANDOM_PASSWORD@postgres:5432/docker_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_MIGRATION_CONFIG=alembic.ini

MODEL_PROVIDER=openai-compatible
MODEL_NAME=REPLACE_WITH_MODEL_NAME
MODEL_API_KEY=
MODEL_BASE_URL=REPLACE_WITH_MODEL_BASE_URL
MODEL_TIMEOUT_SECONDS=60
MODEL_TEMPERATURE=0.1
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=/app/.cache/huggingface
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIMENSION=1024

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_CACHE_DIR=/app/.cache/huggingface
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_USE_FP16=false

TOOL_MODE=mock
ALLOW_LOCAL_DOCKER_TOOLS=false
DOCKER_TOOL_TIMEOUT_SECONDS=15
DOCKER_LOGS_MAX_LINES=200
RUNTIME_EVIDENCE_MAX_CHARS=8000
DYNAMIC_RUNTIME_MAX_STEPS=4

RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=1.0
RERANK_TOP_K=5
RAG_CONTEXT_MAX_CHARS=14000

WEB_PORT=8080
PROMETHEUS_PORT=9090
IMAGE_TAG=local
