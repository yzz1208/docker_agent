APP_NAME=Docker Support Agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docker_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_MIGRATION_CONFIG=alembic.ini

MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=60
MODEL_TEMPERATURE=0.1
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=
EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIMENSION=1024

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=
RERANK_CACHE_DIR=
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_USE_FP16=true

TOOL_MODE=mock
ALLOW_LOCAL_DOCKER_TOOLS=false
DOCKER_TOOL_TIMEOUT_SECONDS=15
DOCKER_LOGS_MAX_LINES=200
RUNTIME_EVIDENCE_MAX_CHARS=8000
DYNAMIC_RUNTIME_MAX_STEPS=4

RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=1.0
RERANK_TOP_K=5
RAG_CONTEXT_MAX_CHARS=14000
