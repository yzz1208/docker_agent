APP_NAME=Docker Support Agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docker_agent

MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=
EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIMENSION=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

TOOL_MODE=mock
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
