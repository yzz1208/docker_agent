# 应用环境配置
APP_ENV=development

# 数据库配置
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/docker_agent

# LLM 模型配置
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.openai.com/v1

# Embedding 模型配置
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker 模型配置
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 工具模式：mock 或 local
TOOL_MODE=mock

# 检索配置
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
