APP_NAME=Docker Support Agent Test
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=WARNING

DATABASE_URL=sqlite+pysqlite:///:memory:
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_MIGRATION_CONFIG=alembic.ini

MODEL_PROVIDER=test
MODEL_NAME=test-model
MODEL_API_KEY=
MODEL_BASE_URL=http://127.0.0.1:9999/v1
MODEL_TIMEOUT_SECONDS=5
MODEL_TEMPERATURE=0
MODEL_MAX_RETRIES=0
MODEL_RETRY_BACKOFF_SECONDS=0

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=2
EMBEDDING_DIMENSION=1024

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_CACHE_DIR=
RERANK_BATCH_SIZE=2
RERANK_MAX_LENGTH=512
RERANK_USE_FP16=false

TOOL_MODE=mock
ALLOW_LOCAL_DOCKER_TOOLS=false
DOCKER_TOOL_TIMEOUT_SECONDS=5
DOCKER_LOGS_MAX_LINES=50
RUNTIME_EVIDENCE_MAX_CHARS=4000
DYNAMIC_RUNTIME_MAX_STEPS=2

RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=1.0
RERANK_TOP_K=3
RAG_CONTEXT_MAX_CHARS=8000
RAG_WARMUP_ON_STARTUP=false

INCIDENT_MAX_HYPOTHESES=3
INCIDENT_MAX_NEXT_STEPS=5
